# Copia este archivo como .env.local y completa la llave del formulario.
# .env.local no se sube al repositorio (está en .gitignore).
#
# Web3Forms: llave pública ("access key") de https://web3forms.com
# Formspree: el id del formulario (lo que va después de /f/ en su URL)
#
# Si no defines VITE_FORM_KEY se usa `contact.formKey` de src/content/site.ts.
VITE_FORM_KEY=
